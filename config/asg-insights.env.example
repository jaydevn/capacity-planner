# asg-insights runtime configuration
#
# Copy this file to /etc/asg-insights/asg-insights.env on the EC2 instance
# and edit the values. The asg-puller.service unit sources it automatically
# via `EnvironmentFile=-/etc/asg-insights/asg-insights.env`.
#
# After changing this file:
#   sudo systemctl restart asg-puller.timer
#   sudo systemctl start asg-puller.service    # kick a run right now
#   sudo journalctl -u asg-puller.service -n 40 --no-pager
#
# Read `configured_regions()` in app/pull_metrics.py to see the parsing rules.

# ---- Region scope (multi-region) -----------------------------------------
# 'all' (the default when unset) scans EVERY region enabled in the account,
# discovered at runtime via ec2:DescribeRegions. Set a comma-separated list
# instead to restrict scanning to specific regions.
ASG_SCAN_REGIONS=all
# Example of restricting to specific regions:
# ASG_SCAN_REGIONS=us-east-1,us-west-2,eu-west-1,ap-south-1

# ---- ASG discovery filter ------------------------------------------------
# Only ASGs carrying this tag key/value are picked up.
ASG_DISCOVERY_TAG_KEY=Environment
ASG_DISCOVERY_TAG_VAL=prod

# ---- Poll cadence knobs --------------------------------------------------
# Minutes to look back per poll. Default matches the systemd timer (1 h).
ASG_POLL_WINDOW_MIN=60

# Default CloudWatch aggregation period (seconds). Overridden per-ASG when
# an ASG is tagged AsgInsightsResolution=1min.
ASG_METRIC_PERIOD_SEC=300

# ---- Per-ASG high-resolution opt-in tag ---------------------------------
# ASGs tagged with this key/value get pulled at Period=60 into asg_snapshots.
ASG_RESOLUTION_TAG_KEY=AsgInsightsResolution
ASG_RESOLUTION_TAG_HIGH_VAL=1min

# ---- SQLite location -----------------------------------------------------
# Overridden by systemd unit — set here only if running the puller by hand.
# ASG_INSIGHTS_DB=/var/lib/asg-insights/asg_insights.db
